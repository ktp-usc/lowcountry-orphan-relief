{
  "name": "sc-economics-2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:jotform": "node scripts/test-jotform.mjs",
    "test:jotform:unit": "node --test tests/jotform-fetch.test.mjs",
    "test:referral": "node --test tests/normalize-referral.test.mjs",
