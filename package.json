{
  "name": "sc-economics-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:jotform": "node scripts/test-jotform.mjs",
    "test:jotform:unit": "node --test tests/jotform-fetch.test.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test": "prisma db execute --file prisma/tests/inventory-constraints.sql",
    "db:seed": "prisma db seed",
    "db:seed:demo": "prisma db seed -- --demo",
    "db:test:seed": "node scripts/test-inventory-seed.mjs",
    "db:test:inventory": "node scripts/test-inventory-query.mjs",
    "import:starting-inventory": "node --conditions=react-server --import tsx scripts/import-starting-inventory.ts",
    "test:inventory:unit": "node scripts/test-inventory-query.mjs --unit",
    "db:check:seed": "node scripts/check-inventory-seed.mjs",
    "check:inventory": "node scripts/check-inventory.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.575.0",
    "next": "16.4.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.4.0"
  }
}
