    "test:sync:submission": "node --test tests/sync-submission.test.mjs",
    "check:jotform:import": "node scripts/run-jotform-import.mjs check",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test": "prisma db execute --file prisma/tests/inventory-constraints.sql",
    "db:seed": "prisma db seed",
    "db:seed:demo": "prisma db seed -- --demo",
    "db:test:seed": "node scripts/test-inventory-seed.mjs",
    "db:test:inventory": "node scripts/test-inventory-query.mjs",
    "test:inventory:unit": "node scripts/test-inventory-query.mjs --unit",
    "db:check:seed": "node scripts/check-inventory-seed.mjs",
    "check:inventory": "node scripts/check-inventory.mjs",
    "test:normalize:inventory": "node --test tests/normalize-inventory.test.mjs",
    "test:save:submission": "node --test tests/save-submission.test.mjs",
    "test:save:submission:integration": "node --test tests/save-submission.integration.test.mjs",
    "import:starting-inventory": "node --conditions=react-server --import tsx scripts/import-starting-inventory.ts",
    "test:sheets:reader": "node --test tests/read-sheet.test.mjs",
    "verify:sheet-imports": "node --no-warnings --loader ./scripts/lib/sheet-ts-loader.mjs scripts/verify-sheet-imports.ts",
    "test:sheets": "node --no-warnings --loader ./scripts/lib/sheet-ts-loader.mjs --test tests/normalize-sheet-row.test.mjs tests/sheet-csv.test.mjs",
    "inspect:sheets": "node --import tsx scripts/inspect-sheets.ts",
    "sync:sheets": "node --import tsx scripts/sync-sheets.ts",
    "test:sync:sheets": "node --import tsx --test tests/sync-sheets.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
