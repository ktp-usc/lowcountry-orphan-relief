# Use Neon's pooled URL for app connections and the direct URL for migrations.
# Preserve sslmode=require on both. These values are server-only.
DATABASE_URL=""
DIRECT_URL=""

# Server-only Jotform key with permission to read the selected forms.
JOTFORM_API_KEY=""
# Optional region: https://eu-api.jotform.com or https://hipaa-api.jotform.com
JOTFORM_API_BASE_URL="https://api.jotform.com"
