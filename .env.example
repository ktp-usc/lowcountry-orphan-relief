# Use Neon's pooled URL for app connections and the direct URL for migrations.
# Preserve sslmode=require on both. These values are server-only.
DATABASE_URL=""
DIRECT_URL=""

# Server-only Jotform key with permission to read the selected forms.
JOTFORM_API_KEY=""
# Optional region: https://eu-api.jotform.com or https://hipaa-api.jotform.com
JOTFORM_API_BASE_URL="https://api.jotform.com"
# Google sign-in (Better Auth). Create credentials in Google Cloud Console.
# ALLOWED_EMAILS is a comma-separated list of Google emails allowed to sign in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
ALLOWED_EMAILS=""

# Server-only Google Sheets service account JSON. Never use NEXT_PUBLIC_.
# Paste the entire JSON object as a single-quoted dotenv value; preserve the
# JSON's escaped \n characters inside private_key. Share Sheets as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=''
