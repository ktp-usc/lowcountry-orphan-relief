generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Location {
  LOWCOUNTRY
  MIDLANDS
}

enum SourceType {
  INVENTORY
  REFERRAL
}

enum InventoryDirection {
  IN
  OUT
}

model Item {
  id                  Int                 @id @default(autoincrement())
  code                String              @unique
  displayName         String
  inventoryActivities InventoryActivity[]
  startingInventories StartingInventory[]
  valuations          ItemValuation[]
}

model SourceSubmission {
  id                  Int                 @id @default(autoincrement())
  jotformFormId        String
  jotformSubmissionId  String
  location            Location
  sourceType          SourceType
  submissionDate      DateTime            @db.Timestamptz(3)
  inventoryActivities InventoryActivity[]

  @@unique([jotformFormId, jotformSubmissionId])
  @@index([location, submissionDate])
}

model InventoryActivity {
  id                  Int                @id @default(autoincrement())
  jotformFormId       String
  jotformSubmissionId String
  itemId              Int
  /// Positive magnitude; direction determines whether stock is added or removed.
  quantity            Int
  direction           InventoryDirection
  sourceSubmission    SourceSubmission   @relation(fields: [jotformFormId, jotformSubmissionId], references: [jotformFormId, jotformSubmissionId], onDelete: Restrict, onUpdate: Cascade)
  item                Item               @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([jotformFormId, jotformSubmissionId])
  @@index([itemId])
}

model StartingInventory {
  id               Int      @id @default(autoincrement())
  itemId           Int
  year             Int
  location         Location
  startingQuantity Int
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([itemId, year, location])
  @@index([location, year])
}

model ItemValuation {
  id           Int     @id @default(autoincrement())
  itemId       Int
  year         Int
  /// Estimated USD value per unit; stored as an exact decimal, not a float.
  valuePerUnit Decimal @db.Decimal(12, 2)
  item         Item    @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([itemId, year])
}

// Scheduling metadata only; no relationship or cascading writes to inventory.
model SheetSyncJob {
  sourceKey                String
  bucket                   Int
  leaseOwner               String?
  leaseExpiresAt           DateTime? @db.Timestamptz(3)
  lastSuccessfulAt         DateTime? @db.Timestamptz(3)
  lastSuccessDurationMs     Int?
  lastSuccessProcessedRows  Int?
  lastSuccessBucketCount    Int?

  @@id([sourceKey, bucket])
}

model SheetSyncAttempt {
  id             String    @id
  sourceKey      String
  bucket         Int
  bucketCount    Int
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  status         String   @default("RUNNING")
  durationMs     Int?
  processedRows  Int?
  summary        Json?
  error          String?

  @@index([sourceKey, bucket, startedAt])
  @@index([status, startedAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
